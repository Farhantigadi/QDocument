{
  "version": 2,
  "installCommand": "pnpm install --no-frozen-lockfile",
  "builds": [
    {
      "src": "artifacts/document-vault/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)",                        "dest": "/api/$1" },
    { "src": "/assets/(.*)",                     "dest": "/assets/$1" },
    { "handle": "filesystem" },
    { "src": "(.*)",                              "dest": "/index.html" }
  ]
}
