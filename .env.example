# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is already in .gitignore.

# ── Session ────────────────────────────────────────────────────────────────────
# Random 32+ char string used to sign JWT session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-random-32-char-string

# ── Database ───────────────────────────────────────────────────────────────────
# Supabase pooled connection (port 6543 for serverless/edge).
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── Encryption ─────────────────────────────────────────────────────────────────
# 32-byte hex key (64 hex chars) for AES-256-GCM vault encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_ENCRYPTION_KEY=replace-with-64-hex-chars

# ── Admin ──────────────────────────────────────────────────────────────────────
# The email address that gets the ADMIN role on signup.
ADMIN_EMAIL=you@example.com

# ── Email (Gmail SMTP) ─────────────────────────────────────────────────────────
# Used to send OTP verification and password reset emails.
# 1. Enable 2-Step Verification on your Google account
# 2. Go to Google Account → Security → App Passwords → generate one
# 3. Paste the 16-char app password (no spaces)
SMTP_USER=you@gmail.com
SMTP_PASS=replace-with-16-char-app-password

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
